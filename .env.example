# Copy this file to `.env` (repo root) or `apps/<your-app>/.env` and fill in real values.
# `.env` is gitignored. Inline env vars (e.g. PowerShell `$env:X=...`) override .env values.

# Which app under apps/ to target. Defaults to the bundled worked example if unset.
TARGET_APP=asteron-quote-apply

# Base URL of the target application (used for login + relative navigation).
BASE_URL=https://your-app.example.com

# Login credentials for the target app's test account.
LOGIN_EMAIL=your-email@example.com
LOGIN_PASSWORD=your-password

# Optional: where probe/evidence screenshots are written.
SCREENSHOT_DIR=./evidence

# ── Back-compat aliases (still honoured; prefer the generic names above) ──
# ASTERON_LOGIN_EMAIL=your-email@example.com
# ASTERON_LOGIN_PASSWORD=your-password

# ── Multiple accounts / parallel multi-session runs ──
# This .env holds ONE account (used by `node run.js test`). To run several specs in PARALLEL across
# MULTIPLE accounts (one login session per account — the platform allows only one session per
# account at a time), do NOT add more logins here. Instead copy `apps/<app>/accounts.example.json`
# to `apps/<app>/accounts.json` (gitignored), list each account there, and use the launcher:
#     node tools/parallel-run.js --all            # every spec, fanned across your accounts
#     node tools/parallel-run.js <spec> [<spec>]  # named specs across accounts
#     node tools/parallel-run.js --list           # show discovered accounts + specs
# Each account `id` maps to its own auth-state file (.auth/state-qa-<id>.json), auto-created on first run.
